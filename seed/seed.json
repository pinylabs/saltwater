							"children": [
								{
									"_type": "span",
									"text": "The photographs are linked from Unsplash and the coast clip from Pexels, each with its photographer named on the page where it appears and all of them listed in the footer. Nothing is copied into this site.",
									"_key": "a5",
									"marks": []
								}
