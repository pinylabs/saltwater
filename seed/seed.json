			{
				"id": "page-tides-and-safety",
				"slug": "tides-and-safety",
				"status": "published",
				"data": {
					"title": "Tides & safety",
					"intro": "A few things that hold for every walk on this coast, whatever the forecast says.",
					"body": [
						{
							"_type": "block",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"text": "The swell",
									"_key": "t1",
									"marks": []
								}
							],
							"_key": "tb1"
						},
						{
							"_type": "block",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"text": "Over about two metres, the rock platforms and low ledges on these walks are not worth it. Check the swell before you go, and check it again at the beach.",
									"_key": "t2",
									"marks": []
								}
							],
							"_key": "tb2"
						},
						{
							"_type": "block",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"text": "The sun",
									"_key": "t3",
									"marks": []
								}
							],
							"_key": "tb3"
						},
						{
							"_type": "block",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"text": "Most of these walks have very little shade. Start early, carry two litres of water, and turn around rather than push on in the heat of the day.",
									"_key": "t4",
									"marks": []
								}
							],
							"_key": "tb4"
						},
						{
							"_type": "block",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"text": "Swimming",
									"_key": "t5",
									"marks": []
								}
							],
							"_key": "tb5"
						},
						{
							"_type": "block",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"text": "Swim between the flags at patrolled beaches, and never alone in a rock pool when the swell is running. The ocean pools on these walks are wonderful and, in a big sea, dangerous.",
									"_key": "t6",
									"marks": []
								}
							],
							"_key": "tb6"
						}
					]
				}
			},
