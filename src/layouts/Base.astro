				.site-header__inner {
					flex-wrap: wrap;
					row-gap: var(--spacing-1);
					min-height: 68px;
					padding-block: var(--spacing-3) var(--spacing-2);
				}

				.brand {
					font-size: 24px;
				}

				.brand__mark {
					width: 24px;
					height: 24px;
				}

				.site-nav {
					order: 3;
					flex-basis: 100%;
				}

				.site-nav ul {
					column-gap: 20px;
				}

				.site-nav a {
					padding-block: 8px;
				}

				.site-search {
					display: none;
				}

				.site-search-link {
					display: inline-grid;
					width: 2.5rem;
					height: 2.5rem;
				}

				.site-footer__pinies {
					flex-direction: column;
					align-items: flex-start;
				}
			}

			@media (max-width: 560px) {
				.site-footer__grid {
					grid-template-columns: minmax(0, 1fr);
				}

				.brand__name {
					max-width: 9rem;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K focuses the header search
			const searchInput =
				document.querySelector<HTMLInputElement>(".site-search-input");
			const kbd = document.querySelector(".site-search__kbd span");
			if (kbd && !/Mac|iPhone|iPad|iPod/.test(navigator.platform)) {
				kbd.textContent = "Ctrl K";
			}
			document.addEventListener("keydown", (e) => {
				if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== "k") return;
				// The header search is hidden on small screens; leave the shortcut to the browser there
				if (!searchInput || searchInput.getClientRects().length === 0) return;
				e.preventDefault();
				searchInput.focus();
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
