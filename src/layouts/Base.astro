---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import Pinies from "../components/Pinies.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;
const menuItems = menu?.items ?? [];

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section (e.g. Posts on a post). */
function navCurrent(url: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(url, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	if (target.search && target.search !== Astro.url.search) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	if (path !== "/" && currentPath.startsWith(`${path}/`)) return "true";
	return undefined;
}

const lang = getSiteLocale() ?? "en";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Instrument+Sans:wght@400..700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap"
		/>
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<header class="site-header">
			<div class="frame site-header__inner">
				<a href="/" class="brand">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="brand__logo"
							/>
						) : (
							<>
								<svg
									class="brand__mark"
									viewBox="0 0 32 32"
									fill="none"
									stroke="currentColor"
									stroke-width="3"
									stroke-linecap="round"
									aria-hidden="true"
									><path
										d="M3 12c4-4 8-4 12 0s8 4 14 0M3 21c4-4 8-4 12 0s8 4 14 0"
									></path></svg
								>
								<span class="brand__name">{siteTitle}</span>
							</>
						)
					}
				</a>
				{
					menuItems.length > 0 && (
						<nav class="site-nav" aria-label="Main">
							<ul>
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
											aria-current={navCurrent(item.url)}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="site-header__actions">
					<div class="site-search" role="search" aria-label="Site">
						<svg
							class="site-search__icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
						<LiveSearch
							placeholder="Search"
							class="site-search__field"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages"]}
						/>
						<kbd class="site-search__kbd" aria-hidden="true"
							><span dir="ltr">⌘K</span></kbd
						>
					</div>
					<a
						href="/search"
						class="icon-btn site-search-link"
						aria-label="Search"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
					</a>
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="btn btn--ghost btn--sm nav-admin">
								Admin
							</a>
						)
					}
				</div>
			</div>
		</header>
		<script is:inline>
			// Inline, so the height is set before the browser scrolls to a URL fragment
			(function () {
				var header = document.querySelector(".site-header");
				function setHeight() {
					document.documentElement.style.setProperty(
						"--header-height",
						header.offsetHeight + "px",
					);
				}
				setHeight();
				new ResizeObserver(setHeight).observe(header);
			})();
		</script>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="frame site-footer__grid">
				<div class="site-footer__brand">
					<a href="/" class="brand">
						{
							siteLogo ? (
								<img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									class="brand__logo"
								/>
							) : (
								<>
									<svg
										class="brand__mark"
										viewBox="0 0 32 32"
										fill="none"
										stroke="currentColor"
										stroke-width="3"
										stroke-linecap="round"
										aria-hidden="true"
										><path
											d="M3 12c4-4 8-4 12 0s8 4 14 0M3 21c4-4 8-4 12 0s8 4 14 0"
										></path></svg
									>
									<span class="brand__name">{siteTitle}</span>
								</>
							)
						}
					</a>
					{siteTagline && <p class="site-footer__tagline">{siteTagline}</p>}
				</div>
				{
					menuItems.length > 0 && (
						<nav class="site-footer__col" aria-labelledby="footer-navigate">
							<h2 id="footer-navigate" class="eyebrow">
								Navigate
							</h2>
							<ul class="site-footer__links">
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="site-footer__col">
					<h2 class="eyebrow">Connect</h2>
					<ul class="site-footer__links">
						<li>
							<a href="/rss.xml">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									><path d="M4 11a9 9 0 0 1 9 9"></path><path
										d="M4 4a16 16 0 0 1 16 16"></path><circle
										cx="5"
										cy="19"
										r="1"></circle></svg
								>
								RSS feed
							</a>
						</li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__widgets">
					<WidgetArea name="footer" />
				</div>
			</div>
			<div class="frame site-footer__made">
				<div class="site-footer__pinies">
					<Pinies />
					<p>
						Made by the Pinies in <a
							class="site-footer__piny"
							href="https://piny.studio/home/"
							><img
								src="/brand/piny-studio-mark.png"
								width="21"
								height="21"
								alt=""
							/><span>Piny Studio</span></a
						>,
						on <a href="https://emdashcms.com">EmDash</a>.<br />Walked and
						checked by people.
					</p>
				</div>
				<p class="site-footer__credits">
					Photos on Unsplash, by <a
						href="https://unsplash.com/photos/a-person-standing-on-a-cliff-overlooking-the-ocean-TfME1TgD-hQ"
						>Dominic Kurniawan Suryaputra</a
					>, <a href="https://unsplash.com/photos/sea-cliff-during-daytime-GKrux4c4Sbc"
						>Gary Runn</a
					>, <a
						href="https://unsplash.com/photos/white-cliffs-towering-over-a-deep-blue-ocean-hf23qR1E3dw"
						>Matt Str</a
					>, <a
						href="https://unsplash.com/photos/a-red-and-white-lighthouse-sitting-on-top-of-a-cliff-next-to-the-ocean-vDBVSOp38yE"
						>Steven Zhang</a
					>, <a
						href="https://unsplash.com/photos/blue-and-brown-swimming-pool-beside-blue-and-white-ocean-water-during-daytime-eBQ7Uzux3qk"
						>Kelvin Li</a
					> and <a href="https://unsplash.com/photos/blue-body-of-water-near-cliff-YPZPUwJIwak"
						>Jack Bass</a
					>.
				</p>
			</div>
			<div class="site-footer__bottom">
				<div class="frame site-footer__bottom-inner">
					<p class="site-footer__meta">{`© ${year} ${siteTitle}.`}</p>
					<div class="theme-switcher" role="group" aria-label="Color theme">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Light"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><circle cx="12" cy="12" r="4"></circle><path
									d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Dark"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><path
									d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="System"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><rect x="2" y="3" width="20" height="14" rx="2"></rect><path
									d="M8 21h8M12 17v4"></path></svg
							>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			// Initialize
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			/*
			 * Page changes: the home's cross-document view transition
			 * (src/pages/index.astro), so moving between the home and these
			 * pages fades and slides the same way. Still under reduced motion.
			 */
			@view-transition {
				navigation: auto;
			}

			::view-transition-old(root) {
				animation: 260ms cubic-bezier(0.4, 0, 1, 1) both vt-out;
			}

			::view-transition-new(root) {
				animation: 420ms cubic-bezier(0, 0, 0.2, 1) 80ms both vt-in;
			}

			@keyframes vt-out {
				to {
					opacity: 0;
					transform: translateY(-12px);
				}
			}

			@keyframes vt-in {
				from {
					opacity: 0;
					transform: translateY(24px);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				@view-transition {
					navigation: none;
				}
			}

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					-webkit-text-size-adjust: 100%;
				}

				/*
				 * Fragment targets clear the sticky header. Not a scroll-padding
				 * on html: that also applies to the search field inside the
				 * header, and the page scrolls on every keystroke.
				 * --header-height is measured by a script, since the header
				 * grows when the menu wraps.
				 */
				:target {
					scroll-margin-block-start: calc(
						var(--header-height, var(--nav-height)) + var(--spacing-6)
					);
				}

				body {
					display: flex;
					flex-direction: column;
					min-height: 100vh;
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
				}

				main {
					flex: 1;
				}

				main:focus {
					outline: none;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration-line: underline;
					text-decoration-thickness: 1px;
					text-decoration-color: var(--color-border-strong);
					text-underline-offset: 0.2em;
					transition:
						color var(--transition-fast),
						text-decoration-color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					text-decoration-color: currentColor;
				}

				:where(:not([class*="emdash"]):not([class*="ec-"])):focus-visible {
					outline: 2px solid var(--color-brand);
					outline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					font-stretch: var(--font-stretch-heading);
					text-transform: var(--text-transform-heading);
					letter-spacing: var(--tracking-snug);
					text-wrap: balance;
					overflow-wrap: break-word;
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				p {
					text-wrap: pretty;
				}

				kbd {
					font-family: var(--font-mono);
				}

				@media (max-width: 640px) {
					:target {
						scroll-margin-block-start: var(--spacing-6);
					}
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						transition-duration: 0.01ms !important;
						animation-duration: 0.01ms !important;
						animation-iteration-count: 1 !important;
					}
				}

				/* Shared building blocks used by every page */

				.sr-only {
					position: absolute;
					width: 1px;
					height: 1px;
					padding: 0;
					margin: -1px;
					overflow: hidden;
					clip-path: inset(50%);
					white-space: nowrap;
					border: 0;
				}

				.skip-link {
					position: fixed;
					top: var(--spacing-2);
					inset-inline-start: var(--spacing-2);
					z-index: 200;
					padding: var(--spacing-2) var(--spacing-4);
					border-radius: var(--radius-full);
					background: var(--color-brand);
					color: var(--color-on-brand);
					font-size: var(--font-size-sm);
					font-weight: 500;
					text-decoration: none;
					translate: 0 calc(-100% - var(--spacing-4));
					transition: translate var(--transition-fast);
				}

				.skip-link:focus-visible {
					translate: 0 0;
				}

				/* Content frame: aligned with the rails */
				.frame {
					width: var(--frame-width);
					margin-inline: auto;
					padding-inline: var(--frame-padding);
				}

				/* A full-bleed horizontal section; Saltwater's sections run on without rules, as on the home */
				.band {
					position: relative;
				}

				/* Vertical rhythm for content bands */
				.section {
					padding-block: clamp(2.5rem, 1.75rem + 2.5vw, 4rem);
				}

				/* Page intro: eyebrow, display title, optional lead */
				.intro {
