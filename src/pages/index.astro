---
/**
 * The home page: the coast clip behind the headline, the five walks as a
 * mosaic with each card marked as coming, the field log, the safety band and
 * the quote. Every word and every address comes from seed/seed.json.
 */
import CoastClip from "../components/CoastClip.astro";
import RouteEdge from "../components/RouteEdge.astro";
import WalkCard from "../components/WalkCard.astro";
import Site from "../layouts/Site.astro";
import {
	getCounters,
	getHome,
	getLogEntries,
	getSafetyNotes,
	getWalks,
} from "../lib/content";

const [home, walks, log, safety, counters] = await Promise.all([
	getHome(),
	getWalks(),
	getLogEntries(),
	getSafetyNotes(),
	getCounters(),
]);
---

<Site title="Saltwater" description={home?.heroIntro} variant="hero">
	<main id="main">
		<section class="hero">
			{home?.clipUrl && (
				<CoastClip
					src={home.clipUrl}
					poster={home.clipPoster}
					description={home.clipAlt}
				/>
			)}

			<div class="wrap hero__inner lift">
				<h1>
					<span class="line"><span style="--i:0">{home?.heroLine1}</span></span>
					<span class="line"
						><span style="--i:1"
							>{home?.heroLine2} <em>{home?.heroHighlight}</em></span
						></span
					>
				</h1>
				{home?.heroIntro && (
					<p class="hero__intro rise" style="--i:2">{home.heroIntro}</p>
				)}
				{home?.ctaLabel && (
					<p class="hero__actions rise" style="--i:3">
						<a class="button" href={home.ctaHref || "/walks"}>{home.ctaLabel}</a>
						{home.cta2Label && (
							<a class="button button--ghost" href={home.cta2Href || "/walks"}>
								{home.cta2Label}
							</a>
						)}
					</p>
				)}
			</div>

			<RouteEdge />

			{home?.clipCredit && (
				<p class="hero__credit">
					Video: <a href={home.clipCreditUrl}>{home.clipCredit}</a>, Pexels
				</p>
			)}
		</section>

		<section class="walks" aria-labelledby="walks-heading">
			<div class="wrap">
				{home?.walksEyebrow && <p class="eyebrow reveal">{home.walksEyebrow}</p>}
				<h2 id="walks-heading" class="reveal">
					{home?.walksHeading1}<br />{home?.walksHeading2}
				</h2>
				{home?.walksNote && <p class="walks__note reveal">{home.walksNote}</p>}

				<div class="mosaic">
					{walks.map((walk) => <WalkCard walk={walk} />)}
				</div>
			</div>
		</section>

		<section class="log" aria-labelledby="log-heading">
			<div class="wrap log__inner">
				<div class="counts reveal">
					{counters.map((counter) => (
						<div>
							<b>{counter.value}</b>
							<span>{counter.label}</span>
						</div>
					))}
				</div>
				<div class="reveal-side">
					<h2 id="log-heading">{home?.logHeading}</h2>
					<ol>
						{log.map((entry) => (
							<li>
								<span class="log__when">{entry.when}</span>
								<span>{entry.text}</span>
							</li>
						))}
					</ol>
				</div>
			</div>
		</section>

		<section class="band" aria-labelledby="band-heading">
			<div class="wrap band__inner">
				<h2 id="band-heading" class="reveal-side">
					{home?.bandHeading1}<br />{home?.bandHeading2}
				</h2>
				<ul>
					{safety.map((note) => (
						<li class="reveal">
							<b>{note.title}</b>
							{note.text}
						</li>
					))}
				</ul>
			</div>
		</section>

		{home?.quote && (
			<section class="strip" aria-label="A note from the walk">
				{home.quotePhoto && (
					<img
						class="zoom-in"
						src={home.quotePhoto}
						alt={home.quotePhotoAlt}
						loading="lazy"
						decoding="async"
					/>
				)}
				<blockquote class="reveal">
					{home.quote}
					<small>
						{home.quoteAttribution}
						{home.quoteCredit && (
							<>
								{" · Photo: "}
								<a href={home.quoteCreditUrl}>{home.quoteCredit}</a>
							</>
						)}
					</small>
				</blockquote>
			</section>
		)}
	</main>
</Site>
