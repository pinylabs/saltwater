---
/**
 * The home page: the coast clip behind the headline, the five walks as a
 * mosaic with each card marked as coming, the field log, the safety band and
 * the quote. Every word and every address comes from seed/seed.json.
 */
import CoastClip from "../components/CoastClip.astro";
import RouteEdge from "../components/RouteEdge.astro";
import WalkCard from "../components/WalkCard.astro";
import Site from "../layouts/Site.astro";
import {
	getCounters,
	getHome,
	getLogEntries,
	getSafetyNotes,
	getWalks,
} from "../lib/content";

const [home, walks, log, safety, counters] = await Promise.all([
	getHome(),
	getWalks(),
	getLogEntries(),
	getSafetyNotes(),
	getCounters(),
]);
---

<Site title="Saltwater" description={home?.heroIntro} variant="hero">
	<main id="main">
		<section
			class="on-dark shade-hero relative isolate flex h-hero min-h-hero-min items-end overflow-hidden text-white max-md:h-hero-sm max-md:min-h-0"
		>
			{home?.clipUrl && (
				<CoastClip
					src={home.clipUrl}
					poster={home.clipPoster}
					description={home.clipAlt}
				/>
			)}

			<div class="wrap lift w-full pb-33 max-md:pb-27.5">
				<h1 class="text-hero leading-hero max-md:text-hero-sm">
					<span class="tide-line"><span class="tide" style="--i:0">{home?.heroLine1}</span></span>
					<span class="tide-line"
						><span class="tide" style="--i:1"
							>{home?.heroLine2} <em class="text-secondary-400 not-italic">{home?.heroHighlight}</em></span
						></span
					>
				</h1>
				{home?.heroIntro && (
					<p class="rise mt-5.5 mb-7 max-w-hero-intro font-serif text-intro leading-snug max-md:text-lead" style="--i:2">
						{home.heroIntro}
					</p>
				)}
				{home?.ctaLabel && (
					<p class="rise flex flex-wrap gap-3.5" style="--i:3">
						<a class="button" href={home.ctaHref || "/walks"}>{home.ctaLabel}</a>
						{home.cta2Label && (
							<a class="button button--ghost" href={home.cta2Href || "/walks"}>
								{home.cta2Label}
							</a>
						)}
					</p>
				)}
			</div>

			<RouteEdge />

			{home?.clipCredit && (
				<p class="absolute top-24 right-10 z-2 text-credit opacity-85 max-md:top-26 max-md:right-4.5">
					Video: <a class="underline underline-offset-3" href={home.clipCreditUrl}>{home.clipCredit}</a>, Pexels
				</p>
			)}
		</section>

		<section class="pt-24 pb-18 max-md:pt-16 max-md:pb-12" aria-labelledby="walks-heading">
			<div class="wrap">
				{home?.walksEyebrow && <p class="eyebrow reveal">{home.walksEyebrow}</p>}
				<h2 id="walks-heading" class="reveal mt-2.5 mb-4.5 text-display-xl max-md:text-display-sm">
					{home?.walksHeading1}<br />{home?.walksHeading2}
				</h2>
				{home?.walksNote && (
					<p class="reveal mb-8.5 max-w-note font-serif text-note leading-comfy text-neutral-600 dark:text-neutral-300">
						{home.walksNote}
					</p>
				)}

				<div class="grid grid-cols-mosaic gap-5.5 max-md:grid-cols-stack max-md:gap-4.5">
					{walks.map((walk) => <WalkCard walk={walk} />)}
				</div>
			</div>
		</section>

		<section class="pb-22 max-md:pb-14" aria-labelledby="log-heading">
			<div class="wrap grid grid-cols-log items-start gap-14 max-md:grid-cols-stack max-md:gap-7">
				<div class="reveal grid grid-cols-pair gap-3.5">
					{counters.map((counter) => (
						<div class="rounded-card bg-primary-700 p-5.5 text-white dark:bg-primary-800">
							<b class="block font-display font-condensed text-display leading-display font-extrabold text-secondary-400 max-md:text-display-xs">
								{counter.value}
							</b>
							<span class="text-label font-semibold tracking-widest uppercase">{counter.label}</span>
						</div>
					))}
				</div>
				<div class="reveal-side">
					<h2 id="log-heading" class="mb-4.5 text-title-lg">{home?.logHeading}</h2>
					<ol class="border-t-2 border-neutral-800 dark:border-neutral-50">
						{log.map((entry) => (
							<li class="grid grid-cols-log-entry gap-4.5 border-b border-tertiary-200 py-3.5 font-serif text-lead leading-snug max-md:grid-cols-log-entry-sm max-md:text-body dark:border-neutral-700">
								<span class="font-display font-condensed text-quote leading-tight font-extrabold text-primary-700 uppercase dark:text-primary-400">
									{entry.when}
								</span>
								<span>{entry.text}</span>
							</li>
						))}
					</ol>
				</div>
			</div>
		</section>

		<section class="bg-secondary-400 text-neutral-800" aria-labelledby="band-heading">
			<div class="wrap grid grid-cols-band items-center gap-12 py-18 max-md:grid-cols-stack max-md:gap-6.5 max-md:py-13">
				<h2 id="band-heading" class="reveal-side text-display-lg max-md:text-display-sm">
					{home?.bandHeading1}<br />{home?.bandHeading2}
				</h2>
				<ul class="grid grid-cols-pair gap-x-7 gap-y-4.5 font-serif text-lead leading-cozy max-md:grid-cols-stack">
					{safety.map((note) => (
						<li class="reveal">
							<b class="mb-0.5 block font-sans text-nav tracking-widest uppercase">{note.title}</b>
							{note.text}
						</li>
					))}
				</ul>
			</div>
		</section>

		{home?.quote && (
			<section
				class="relative isolate grid h-strip place-items-center overflow-hidden text-center text-white max-md:h-strip-sm after:absolute after:inset-0 after:-z-1 after:bg-primary-950/35"
				aria-label="A note from the walk"
			>
				{home.quotePhoto && (
					<img
						class="zoom-in absolute inset-0 -z-2 size-full object-cover"
						src={home.quotePhoto}
						alt={home.quotePhotoAlt}
						loading="lazy"
						decoding="async"
					/>
				)}
				<blockquote class="reveal max-w-quote px-6 font-serif text-display-md leading-tight italic max-md:text-title-sm">
					{home.quote}
					<small class="mt-4.5 block font-sans text-nav not-italic opacity-90">
						{home.quoteAttribution}
						{home.quoteCredit && (
							<>
								{" · Photo: "}
								<a class="underline underline-offset-3" href={home.quoteCreditUrl}>{home.quoteCredit}</a>
							</>
						)}
					</small>
				</blockquote>
			</section>
		)}
	</main>
</Site>
