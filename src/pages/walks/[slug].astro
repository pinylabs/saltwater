---
/**
 * One walk, from its photograph down to the places it passes. The card that
 * brought the reader here shares this page's hero, so the picture grows into
 * place as the page changes.
 */
import { PortableText } from "emdash/ui";
import Site from "../../layouts/Site.astro";
import { getWalk } from "../../lib/content";

const slug = Astro.params.slug;
const found = slug ? await getWalk(slug) : null;

if (!found) {
	return Astro.rewrite("/404");
}

const { walk, stops, story } = found;
const coming = walk.status !== "walked";
const hero = walk.heroPhoto || walk.photo;

const stats = [
	{ value: walk.distance, label: "Distance" },
	{ value: walk.duration, label: "Time" },
	{ value: walk.grade, label: "Grade" },
	{ value: walk.start, label: "Start" },
	{ value: walk.finish, label: "Finish" },
].filter((stat) => stat.value);
---

<Site
	title={walk.title}
	description={walk.summary || walk.comingNote || `${walk.title} on Saltwater`}
	variant="hero"
>
	<main id="main">
		<section class="shade-walk relative isolate flex h-walk-hero items-end overflow-hidden text-white max-md:h-walk-hero-sm">
			<img
				class="absolute inset-0 -z-2 size-full object-cover"
				src={hero}
				alt={walk.photoAlt}
				style={`view-transition-name: walk-${walk.slug}`}
			/>
			<div class="wrap w-full pb-12">
				<p class="text-label font-semibold opacity-95">
					<a class="underline underline-offset-3" href="/walks">Walks</a>
					{walk.region && <> › {walk.region}</>}
				</p>
				<h1 class="rise mt-2 text-walk leading-hero max-md:text-walk-sm" style="--i:1">{walk.title}</h1>
			</div>
			{walk.photoCredit && (
				<p class="absolute right-10 bottom-3 text-credit opacity-85 max-md:right-4.5">
					Photo: <a class="underline underline-offset-3" href={walk.photoCreditUrl}>{walk.photoCredit}</a>
				</p>
			)}
		</section>

		{stats.length > 0 && (
			<section class="bg-primary-700 text-neutral-50 dark:bg-primary-800" aria-label="The walk in numbers">
				{/* The design's own band: 22px above and below the numbers, which start at the column's edge without
				    the page's side padding, on a phone too. */}
				<div class="wrap grid grid-cols-stats px-0 py-5.5 max-md:grid-cols-pair">
					{stats.map((stat) => (
						<div class="border-r border-white/12 py-5.5 pl-5.5 first:pl-0 last:border-r-0 max-md:border-r-0 max-md:pl-0">
							<b class="block font-display font-condensed text-title leading-solid font-extrabold uppercase">{stat.value}</b>
							<small class="text-caption tracking-widest uppercase opacity-75">{stat.label}</small>
						</div>
					))}
				</div>
			</section>
		)}

		<section
			class="bg-secondary-400 text-neutral-800"
			aria-label={coming ? "This walk is coming" : "This walk was checked"}
		>
			<div class="wrap flex flex-wrap items-baseline gap-x-6 gap-y-2 py-5">
				<strong class="font-display font-condensed text-quote font-extrabold tracking-wide uppercase">
					{coming ? "Coming" : "Walked"}
				</strong>
				<p class="max-w-coming text-nav leading-comfy">
					{coming
						? walk.comingNote || "Nobody has walked this route for Saltwater yet."
						: walk.summary}
				</p>
				<p class="max-w-coming text-nav leading-comfy font-semibold whitespace-nowrap">
					{walk.lastChecked
						? `Last checked ${walk.lastChecked}`
						: "Last checked: no date yet"}
				</p>
			</div>
		</section>

		{story.length > 0 && (
			<section class="story relative bg-primary-950" aria-label="The walk in pictures">
				<div class="story-stage sticky top-0 h-screen overflow-hidden">
					{story.map((stop, index) => (
						<img
							class="absolute inset-0 size-full object-cover"
							src={stop.photo}
							alt={stop.photoAlt}
							loading={index === 0 ? "eager" : "lazy"}
							decoding="async"
							style={index === 0 ? undefined : `--timeline: --story-${index}`}
						/>
					))}
				</div>
				<div class="story-panels relative">
					{story.map((stop, index) => (
						<div
							class="story-panel ml-10 w-story-panel rounded-card bg-tertiary-50/95 px-7 py-6.5 text-neutral-800 shadow-panel max-md:ml-4.5"
							style={`--timeline: --story-${index}`}
						>
							<h2 class="text-title-md leading-heading max-md:text-title-sm">{stop.title}</h2>
							{stop.text && <p class="mt-2.5 font-serif text-read leading-comfy">{stop.text}</p>}
							{stop.photoCredit && (
								<small class="mt-3 block text-credit text-neutral-600">
									Photo: <a class="underline underline-offset-2" href={stop.photoCreditUrl}>{stop.photoCredit}</a>
								</small>
							)}
						</div>
					))}
				</div>
			</section>
		)}

		<div class="wrap grid grid-cols-walk gap-16 pt-16 pb-20 max-md:grid-cols-stack max-md:gap-8 max-md:pt-10 max-md:pb-14">
			<article class="walk-prose">
				<PortableText value={walk.body} />
			</article>

			<aside class="reveal self-start md:sticky md:top-6">
				{stops.length > 0 && (
					<div class="rounded-card border border-tertiary-200 bg-tertiary-50 p-5.5 dark:border-neutral-700 dark:bg-neutral-900">
						<h2 class="text-title-xs leading-solid">The route</h2>
						<svg class="my-2.5 h-auto w-full" viewBox="0 0 240 300" fill="none" aria-hidden="true">
							<path
								d="M40 0 C70 40 30 70 60 100 S 40 160 80 190 S 60 260 110 300"
								stroke="currentColor"
								stroke-opacity=".15"
								stroke-width="40"
								stroke-linecap="round"></path>
							<path
								d="M60 20 C90 50 50 80 80 110 S 60 170 100 200 S 90 250 130 280"
								stroke="#0b4f6c"
								stroke-width="5"
								stroke-linecap="round"></path>
							<g fill="#ffcf4d" stroke="#0d2230" stroke-width="2">
								<circle cx="60" cy="20" r="7"></circle>
								<circle cx="80" cy="110" r="6"></circle>
								<circle cx="100" cy="200" r="6"></circle>
								<circle cx="130" cy="280" r="7"></circle>
							</g>
						</svg>
						<small class="text-credit text-neutral-600 dark:text-neutral-300">A sketch, not to scale.</small>
						<ol class="list-decimal pl-5 text-nav leading-list text-neutral-600 dark:text-neutral-300">
							{stops.map((stop) => <li>{stop}</li>)}
						</ol>
					</div>
				)}

				<div class="mt-4 rounded-box bg-secondary-400 px-4 py-3.5 text-label leading-comfy text-neutral-800">
					<b class="block text-caption tracking-wider uppercase">{coming ? "Not walked yet" : "Last checked"}</b>
					{walk.lastChecked
						? `A person walked this route and checked it on ${walk.lastChecked}.`
						: "No one has walked this route for Saltwater yet, so there is no date to show. It goes up once there is one."}
				</div>
			</aside>
		</div>
	</main>
</Site>
