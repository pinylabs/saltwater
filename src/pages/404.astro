---
import Site from "../layouts/Site.astro";
---

<Site
	title="Page not found"
	description="That page isn't here. The walks are, though."
	variant="solid"
>
	<main id="main">
		<section class="grid min-h-error place-items-center px-10 py-20 text-center max-md:px-4.5">
			<div>
				<p class="eyebrow mx-auto mb-6.5 max-w-message font-serif text-article leading-comfy text-neutral-600 dark:text-neutral-300">
					Error 404
				</p>
				<h1 class="mt-3.5 mb-4 text-error-title">Off the track</h1>
				<p class="mx-auto mb-6.5 max-w-message font-serif text-article leading-comfy text-neutral-600 dark:text-neutral-300">
					That page isn't here. Every walk is, with its photograph, its route
					and the date it was last checked.
				</p>
				<p class="mx-auto mb-6.5 flex max-w-message flex-wrap justify-center gap-3.5 font-serif text-article leading-comfy text-neutral-600 dark:text-neutral-300">
					<a class="button" href="/walks">See every walk</a>
					<a class="button button--quiet" href="/">Back to the start</a>
				</p>
			</div>
		</section>
	</main>
</Site>
