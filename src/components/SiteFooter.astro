---
/**
 * Who made the site, and every photographer and film-maker whose work is
 * linked from here — named, with the page it came from. Nothing is copied into
 * this site; the credits are the link.
 */
import PiniesFaces from "./PiniesFaces.astro";
import type { Credit } from "../lib/content";

interface Props {
	credits: Credit[];
	made?: string;
	line?: string;
	siteName: string;
}

const { credits, made, line, siteName } = Astro.props;

// The sentence of who made the site, with "Piny" in it made a link to Piny Studio that carries its mark.
const sentence = made ?? "Made by the Pinies in Piny, on EmDash.";
const at = sentence.search(/\bPiny\b/);
const before = at < 0 ? sentence : sentence.slice(0, at);
const after = at < 0 ? "" : sentence.slice(at + "Piny".length);
---

<footer class="on-dark bg-primary-900 pt-14 pb-10 text-primary-100 dark:bg-primary-950">
	<div class="wrap grid grid-cols-footer items-end gap-10 max-md:grid-cols-stack max-md:gap-7">
		<div class="flex items-end gap-4.5 max-md:flex-col max-md:items-start max-md:gap-3.5">
			<PiniesFaces />
			<p class="font-serif text-lead leading-snug">
				{before}{at >= 0 && (
					<a class="whitespace-nowrap underline underline-offset-3" href="https://piny.studio/home/"
						><img class="me-1 inline-block size-5 align-middle" src="/brand/piny-studio-mark.png" width="20" height="20" alt="" />Piny Studio</a
					>
				)}{after}
				{line && <><br />{line}</>}
			</p>
		</div>
		<p class="text-caption leading-loose opacity-85">
			Photos on <a class="underline decoration-white/35 underline-offset-3" href="https://unsplash.com/license">Unsplash</a> and the video
			on <a class="underline decoration-white/35 underline-offset-3" href="https://www.pexels.com/license/">Pexels</a>, by{" "}
			{
				credits.map((credit, index) => (
					<>
						{index > 0 && (index === credits.length - 1 ? " and " : ", ")}
						<a class="underline decoration-white/35 underline-offset-3" href={credit.url}>{credit.name}</a>
					</>
				))
			}. Linked from their pages, never copied into {siteName}.
		</p>
	</div>
</footer>
