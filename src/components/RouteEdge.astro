---
/**
 * The first walk's route drawn along the bottom edge of the hero: the line a
 * walker takes from Bondi to Coogee, with a stop at each beach along it.
 * Decorative, so it is hidden from assistive technology; the walk page itself
 * lists every place by name.
 */
---

<div class="pointer-events-none absolute inset-x-0 bottom-0 h-route" aria-hidden="true">
	<svg class="size-full" viewBox="0 0 1440 120" preserveAspectRatio="none">
		<path
			class="route-path"
			d="M40 92 C 220 40, 360 108, 520 70 S 820 30, 980 76 S 1260 104, 1400 58"
			fill="none"
			stroke="#ffcf4d"
			stroke-width="4"
			stroke-linecap="round"></path>
	</svg>
	<svg class="size-full" viewBox="0 0 1440 120" preserveAspectRatio="none">
		<g class="route-stop"><circle cx="40" cy="92" r="7" fill="#ffcf4d"></circle></g>
		<g class="route-stop"><circle cx="520" cy="70" r="6" fill="#ffcf4d"></circle></g>
		<g class="route-stop"><circle cx="980" cy="76" r="6" fill="#ffcf4d"></circle></g>
		<g class="route-stop"><circle cx="1400" cy="58" r="7" fill="#ffcf4d"></circle></g>
	</svg>
	<div class="route-labels font-sans text-caption leading-normal font-semibold text-white text-shadow-label">
		<span class="absolute bottom-2" style="left: 40px">Bondi</span>
		<span class="absolute bottom-2 max-md:hidden" style="left: 36%">Bronte</span>
		<span class="absolute bottom-2 max-md:hidden" style="left: 68%">Clovelly</span>
		<span class="absolute bottom-2" style="right: 40px">Coogee</span>
	</div>
</div>
