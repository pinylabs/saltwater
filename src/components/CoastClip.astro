---
/**
 * The coast clip behind the headline.
 *
 * The poster — the still frame from the clip's own page — is drawn first, so
 * the hero is never empty and nothing is fetched for a reader who asked for
 * less motion. Both addresses come from the home page content; the layout's
 * script loads and plays the clip only when motion is allowed.
 */
interface Props {
	src: string;
	poster: string;
	description: string;
}

const { src, poster, description } = Astro.props;
---

<div class="absolute inset-0 -z-2 size-full bg-primary-900 dark:bg-primary-950">
	<video
		class="absolute inset-0 size-full object-cover"
		muted
		loop
		playsinline
		preload="none"
		poster={poster}
		data-src={src}
		role="img"
		aria-label={description}
	></video>
</div>
