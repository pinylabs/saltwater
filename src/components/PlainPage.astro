---
/**
 * A plain page — about, the map, tides and safety — from the pages collection:
 * its title, its intro and its text.
 */
import { PortableText } from "emdash/ui";
import Site from "../layouts/Site.astro";
import type { PageContent } from "../lib/content";

interface Props {
	page: PageContent;
}

const { page } = Astro.props;
---

<Site title={page.title} description={page.intro} variant="solid">
	<main id="main">
		<section class="border-b border-tertiary-200 pt-14 pb-8.5 dark:border-neutral-700">
			<div class="wrap">
				<h1 class="text-page-title">{page.title}</h1>
				{page.intro && (
					<p class="mt-4.5 max-w-lede font-serif text-quote leading-cozy text-neutral-600 dark:text-neutral-300">
						{page.intro}
					</p>
				)}
			</div>
		</section>

		<section class="pt-11 pb-20 max-md:pb-14">
			<div class="wrap prose max-w-reading">
				<PortableText value={page.body} />
			</div>
		</section>
	</main>
</Site>
